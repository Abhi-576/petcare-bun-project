# PostgreSQL database URL. Use a local PostgreSQL instance or a managed provider.
DATABASE_URL="postgresql://petcare:petcare_dev_password@localhost:5432/petcare?schema=public"

# Generate with: openssl rand -base64 48
# Must be at least 32 characters. Never commit your real secret.
AUTH_SECRET="replace-this-with-a-random-secret-at-least-32-characters-long"

# Optional demo seed password. Never use demo credentials in production.
DEMO_PASSWORD="PetCareDemo!2026"

# Set true only for a disposable local database to create example owner/sitter/admin accounts.
SEED_DEMO_DATA=false
