generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  SITTER
  ADMIN
}
enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}
enum PetSpecies {
  DOG
  CAT
  BIRD
  RABBIT
  OTHER
}
enum VerificationStatus {
  NOT_STARTED
  SUBMITTED
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}
enum BookingStatus {
  PENDING
  ACCEPTED
  REJECTED
  PAYMENT_PENDING
  CONFIRMED
  CHECKED_IN
  ACTIVE
  COMPLETED
  CANCELLED
}
enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}
enum StayUpdateType {
  CHECK_IN
  FOOD
  WALK
  MEDICATION
  PHOTO
  NOTE
  CHECK_OUT
}
enum NotificationType {
  BOOKING
  MESSAGE
  PAYMENT
  STAY_UPDATE
  SAFETY
  SYSTEM
}
enum ReportStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

model User {
  id                String       @id @default(cuid())
  name              String
  email             String       @unique
  passwordHash      String
  role              UserRole     @default(OWNER)
  status            UserStatus   @default(ACTIVE)
  phone             String?
  avatarUrl         String?
  bio               String?
  emailVerifiedAt   DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  pets              Pet[]
  sitterProfile     SitterProfile?
  ownedBookings     Booking[]    @relation("OwnerBookings")
  reviewsWritten    Review[]     @relation("ReviewAuthor")
  reviewsReceived   Review[]     @relation("ReviewTarget")
  sentMessages      Message[]
  notifications     Notification[]
  favorites         Favorite[]
  reportsFiled      Report[]     @relation("ReportReporter")
  reportsAgainst    Report[]     @relation("ReportedUser")
  verifications     Verification[]
}

model Pet {
  id                String    @id @default(cuid())
  ownerId           String
  name              String
  species           PetSpecies
  breed             String?
  ageYears          Float?
  weightKg          Float?
  temperament       String?
  notes             String?
  feedingInstructions String?
  allergies         String?
  medicationNotes   String?
  vetName           String?
  vetPhone          String?
  emergencyContact  String?
  imageUrl          String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  owner             User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  bookings          Booking[]
  @@index([ownerId])
}

model SitterProfile {
  id                 String       @id @default(cuid())
  userId             String       @unique
  headline           String?
  about              String
  city               String
  locality           String?
  dailyRate          Int
  currency           String       @default("INR")
  yearsExperience    Int           @default(0)
  maxPets            Int           @default(1)
  acceptedSpecies    PetSpecies[]  @default([DOG, CAT])
  acceptedSizes      String[]      @default(["small", "medium"])
  homeDescription    String?
  homeImageUrls      String[]      @default([])
  amenities          String[]      @default([])
  houseRules         String[]      @default([])
  outdoorSpace       Boolean       @default(false)
  isAvailable        Boolean       @default(true)
  averageRating      Float         @default(0)
  reviewCount        Int           @default(0)
  identityStatus     VerificationStatus @default(NOT_STARTED)
  addressStatus      VerificationStatus @default(NOT_STARTED)
  homeStatus         VerificationStatus @default(NOT_STARTED)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  availability       Availability[]
  bookings           Booking[]
  reviews            Review[]
  favorites          Favorite[]
  @@index([city, locality])
  @@index([isAvailable, dailyRate])
}

model Verification {
  id            String             @id @default(cuid())
  userId        String
  kind          String
  status        VerificationStatus @default(SUBMITTED)
  submittedAt   DateTime           @default(now())
  reviewedAt    DateTime?
  reviewedById  String?
  rejectionReason String?
  demoRecord    Boolean            @default(false)
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([status, submittedAt])
}

model Availability {
  id          String        @id @default(cuid())
  sitterId    String
  date        DateTime
  isAvailable Boolean       @default(true)
  note        String?
  sitter      SitterProfile @relation(fields: [sitterId], references: [id], onDelete: Cascade)
  @@unique([sitterId, date])
  @@index([date, isAvailable])
}

model Booking {
  id               String        @id @default(cuid())
  ownerId          String
  sitterId         String
  petId            String
  checkIn          DateTime
  checkOut         DateTime
  nights           Int
  dailyRate        Int
  subtotal         Int
  platformFee      Int            @default(0)
  extraCharges     Int            @default(0)
  discount         Int            @default(0)
  total            Int
  currency         String         @default("INR")
  status           BookingStatus  @default(PENDING)
  specialInstructions String?
  cancellationReason String?
  acceptedAt       DateTime?
  checkedInAt      DateTime?
  completedAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  owner            User           @relation("OwnerBookings", fields: [ownerId], references: [id])
  sitter           SitterProfile  @relation(fields: [sitterId], references: [id])
  pet              Pet            @relation(fields: [petId], references: [id])
  payment          Payment?
  stayUpdates      StayUpdate[]
  reviews          Review[]
  conversation     Conversation?
  @@index([ownerId, status])
  @@index([sitterId, status])
  @@index([checkIn, checkOut])
}

model Payment {
  id             String        @id @default(cuid())
  bookingId      String        @unique
  amount         Int
  currency       String        @default("INR")
  status         PaymentStatus @default(PENDING)
  provider       String        @default("DEMO")
  providerRef    String?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  booking        Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model StayUpdate {
  id          String         @id @default(cuid())
  bookingId   String
  authorId    String
  type        StayUpdateType @default(NOTE)
  message     String
  foodLog     String?
  activityLog String?
  medicationLog String?
  photoUrl    String?
  createdAt   DateTime       @default(now())
  booking     Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  @@index([bookingId, createdAt])
}

model Review {
  id          String        @id @default(cuid())
  bookingId   String
  authorId    String
  targetId    String
  sitterId    String
  rating      Int
  comment     String?
  demoRecord  Boolean       @default(false)
  createdAt   DateTime      @default(now())
  booking     Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  author      User          @relation("ReviewAuthor", fields: [authorId], references: [id])
  target      User          @relation("ReviewTarget", fields: [targetId], references: [id])
  sitter      SitterProfile @relation(fields: [sitterId], references: [id])
  @@unique([bookingId, authorId])
  @@index([sitterId, createdAt])
}

model Conversation {
  id          String    @id @default(cuid())
  bookingId   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  booking     Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  messages    Message[]
  @@unique([bookingId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id])
  @@index([conversationId, createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, readAt, createdAt])
}

model Favorite {
  id        String        @id @default(cuid())
  userId    String
  sitterId  String
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sitter    SitterProfile @relation(fields: [sitterId], references: [id], onDelete: Cascade)
  @@unique([userId, sitterId])
}

model Report {
  id             String       @id @default(cuid())
  reporterId     String
  reportedUserId String?
  bookingId      String?
  category       String
  description    String
  status         ReportStatus @default(OPEN)
  resolutionNote String?
  resolvedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  reporter       User         @relation("ReportReporter", fields: [reporterId], references: [id])
  reportedUser   User?        @relation("ReportedUser", fields: [reportedUserId], references: [id])
  @@index([status, createdAt])
}
